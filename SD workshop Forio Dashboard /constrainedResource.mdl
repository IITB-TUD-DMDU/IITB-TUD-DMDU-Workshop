yield per unit capital=yield per unit capital L max*choose yield per unit capital L max\
		+
	yield per unit capital L Mid*choose yield per unit capital L Mid +
	yield per unit capital L least*choose yield per unit capital L least + 0*resource
	~	
	~		|

Capital= INTEG (investment-depreciation,
		intial capital)
	~	Rs
	~		|

investment fraction=0.1
	~	
	~		|

choose yield per unit capital L least=0
	~	
	~		|

choose yield per unit capital L max=0
	~	
	~		|

choose yield per unit capital L Mid=1
	~	
	~		|

growth goal=Capital*investment fraction
	~	
	~		|

intial capital=5
	~	Rs
	~		|

inital resources=1000
	~	Rs
	~		|

resource= INTEG (regeneration-harvest,
		inital resources)
	~	
	~		|

profit=price L*harvest-Capital*investment fraction
	~	
	~		|

